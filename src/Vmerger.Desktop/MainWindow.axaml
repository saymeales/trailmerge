<Window
    x:Class="Vmerger.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Vmerger.Desktop.Controls"
    xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
    Title="vmerger media prototype"
    Width="1180"
    Height="760"
    MinWidth="900"
    MinHeight="560">
    <Grid RowDefinitions="Auto,2*,8,2*" ColumnDefinitions="3*,8,2*" Margin="16" RowSpacing="8" ColumnSpacing="8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                <Menu>
                    <MenuItem Header="_File">
                        <MenuItem x:Name="ImportFolderMenuItem" Header="Import folder" />
                        <MenuItem x:Name="ImportFilesMenuItem" Header="Import files" />
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem x:Name="OpenDiagnosticsMenuItem" Header="Open diagnostics" />
                    </MenuItem>
                </Menu>
            </Grid>

        <Border Grid.Row="1" Grid.Column="0" Background="Black" ClipToBounds="True">
            <vlc:VideoView x:Name="VideoView">
                <Grid RowDefinitions="*,Auto" Margin="14">
                    <Border Background="Transparent" PointerPressed="VideoSurface_OnPointerPressed">
                        <Grid>
                            <Image
                                Source="{Binding CurrentThumbnail}"
                                Stretch="Uniform"
                                IsVisible="{Binding ShowThumbnail}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="16,10"
                                Background="#AA111111"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="SemiBold"
                                IsVisible="{Binding IsPaused}"
                                Text="Paused" />
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Background="#AA111111"
                        BorderBrush="#55444444"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="{Binding PositionText}" />
                            <Slider
                                x:Name="SeekSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="{Binding PlaybackDurationSeconds}"
                                Value="{Binding PlaybackPositionSeconds, Mode=OneWay}"
                                IsEnabled="{Binding HasMedia}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="{Binding DurationText}" />
                        </Grid>
                    </Border>
                </Grid>
            </vlc:VideoView>
        </Border>

        <GridSplitter Grid.Row="2" Grid.Column="0" Height="8" HorizontalAlignment="Stretch" Background="#333333" />
        <GridSplitter Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Width="8" VerticalAlignment="Stretch" Background="#333333" />

        <Grid Grid.Row="1" Grid.Column="2" Grid.RowSpan="3" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="{Binding FolderImportStatus}" />
                <TextBlock Text="{Binding ExportStatus}" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Row="1">
                <Button MinWidth="104" Content="Add trail" Click="AddTrailButton_OnClick" />
                <Button MinWidth="104" Content="Delete trail" Click="DeleteTrailButton_OnClick" />
                <Button MinWidth="104" Content="Merge selected" Click="MergeSelectedTrailsButton_OnClick" IsEnabled="{Binding CanMergeSelectedTrails}" />
                <Button MinWidth="104" Content="Export trail" Click="ExportTrailButton_OnClick" />
                <Button MinWidth="104" Content="Export all" Click="ExportAllTrailsButton_OnClick" />
            </WrapPanel>
            <ListBox x:Name="TrailListBox"
                Grid.Row="2"
                ItemsSource="{Binding Trails}"
                SelectedItem="{Binding SelectedTrail, Mode=TwoWay}"
                SelectionChanged="TrailListBox_OnSelectionChanged"
                SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="6"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="6"
                            DragDrop.AllowDrop="True"
                            DragDrop.DragOver="TrailDrop_OnDragOver"
                            DragDrop.Drop="TrailDrop_OnDrop">
                        <StackPanel Spacing="6">
                            <TextBox FontWeight="SemiBold" Text="{Binding Name, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Summary}" />
                            <ItemsControl ItemsSource="{Binding Clips}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="6"
                                            Margin="0,2"
                                            Background="#888899"
                                            BorderBrush="#555555"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            PointerPressed="TrailClip_OnPointerPressed">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding DurationText}" />
                                                <TextBlock Grid.Row="1" FontSize="11" Text="{Binding RangeText}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Text="{Binding KeyframeSummary}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="3" Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Clip timelines" />
                <WrapPanel Grid.Column="1">
                    <CheckBox
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="Continue to next clip"
                        IsChecked="{Binding ContinueToNextClipOnEnd, Mode=TwoWay}" />
                    <Button MinWidth="96" Content="Clear range" Click="ClearRangeButton_OnClick" />
                    <Button MinWidth="96" Content="Split before" Click="SplitTrailButton_OnClick" />
                    <Button MinWidth="96" Content="Remove clip" Click="RemoveClipButton_OnClick" />
                    <Button MinWidth="96" Content="Duplicate" Click="DuplicateClipButton_OnClick" />
                </WrapPanel>
            </Grid>
            <ListBox
                Grid.Row="1"
                ItemsSource="{Binding SelectedTrail.Clips}"
                SelectedItem="{Binding SelectedClip, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="180,90,*,120" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4" Margin="0,4">
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" />
                            <controls:ClipRangeSlider
                                Grid.Column="2"
                                Height="34"
                                Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                RangeStart="{Binding StartSliderSeconds, Mode=TwoWay}"
                                RangeEnd="{Binding EndSliderSeconds, Mode=TwoWay}" />
                            <StackPanel Grid.Column="3" Grid.RowSpan="3" Spacing="4">
                                <Button MinWidth="96" Content="Start" Click="PreviewClipStartButton_OnClick" />
                                <Button MinWidth="96" Content="Join preview" Click="TransitionPreviewButton_OnClick" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11" Text="{Binding StartText}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" FontSize="15" FontWeight="SemiBold" Text="{Binding RangeText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11" Text="{Binding TimeSourceText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11" Text="{Binding KeyframeSummary}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
