<Window
    x:Class="Vmerger.Desktop.DiagnosticsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Diagnostics"
    Width="900"
    Height="650"
    MinWidth="600"
    MinHeight="400">
    <Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Diagnostics" />
            <Button Grid.Column="1" Content="Clear Ffmpeg Log" Click="ClearExportOutputButton_OnClick" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Probe">
                <TextBox
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{Binding ProbeOutput}"
                    TextWrapping="Wrap"
                    FontFamily="Consolas"
                    FontSize="12"
                    VerticalContentAlignment="Top" />
            </TabItem>
            <TabItem Header="Ffmpeg">
                <TextBox
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{Binding ExportOutput}"
                    TextWrapping="Wrap"
                    FontFamily="Consolas"
                    FontSize="12"
                    VerticalContentAlignment="Top" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
